{
  "name": "leonida-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "assets": "node scripts/prepare-assets.mjs && node scripts/calibrate-map.mjs",
    "test:browser": "node scripts/playtest.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "@types/node": "22.18.6",
    "playwright": "1.55.0",
    "sharp": "0.34.3",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  }
}
